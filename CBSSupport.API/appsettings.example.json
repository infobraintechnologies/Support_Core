{
  "ConnectionStrings": {
    "DefaultConnection": "Host=<postgres-host>;Port=5432;Database=<database>;Username=<application-role>;Password=<from-secret-store>"
  },
  "Security": {
    "PasswordHashing": {
      "Pepper": "<from-user-secrets-or-environment>"
    },
    "LoginAttempts": {
      "SourcePermitLimit": 20,
      "SourceWindow": "00:01:00",
      "FailedAttemptsBeforeBackoff": 5,
      "InitialBackoff": "00:01:00",
      "MaximumBackoff": "00:15:00",
      "StateRetention": "01:00:00",
      "CleanupBatchSize": 1000,
      "CleanupEveryOperations": 256,
      "StoreFailureRetryAfter": "00:00:30"
    },
    "KnownProxies": []
  },
  "DataProtection": {
    "ApplicationName": "CBSSupport",
    "KeyRingPath": "/var/lib/cbssupport/dataprotection-keys",
    "AtRestProtection": "Certificate",
    "CertificatePath": "/run/secrets/cbssupport-dataprotection.pfx",
    "CertificatePassword": "<from-secret-store>",
    "EnforcePrivateKeyRingPermissions": true
  },
  "Jwt": {
    "Enabled": false,
    "Key": "<minimum-32-byte-signing-key-when-enabled>",
    "Issuer": "https://support.example.invalid",
    "Audience": "support-api"
  },
  "Attachments": {
    "Enabled": false,
    "SecurityMode": "StructuralValidationOnly",
    "R2": {
      "AccountId": "<cloudflare-account-id>",
      "AccessKeyId": "<r2-access-key-id>",
      "SecretAccessKey": "<from-secret-store>",
      "BucketName": "<private-bucket-name>",
      "ServiceUrl": "https://<account-id>.r2.cloudflarestorage.com"
    }
  }
}
