                                <option value="">All Clients</option>
                            </select>
                        </div>
                        <div class="d-flex align-items-center">
                            <label for="status-filter-inquiries" class="form-label me-2 mb-0">Status:</label>
                            <select id="status-filter-inquiries" class="form-select" style="width: 150px;">
                                <option value="">All Status</option>
                                <option value="Pending">Pending</option>
                                <option value="Completed">Completed</option>
                            </select>
                        </div>
=
                        <div class="header-notification-container">
                            <button class="btn btn-outline-secondary header-notification-btn" id="admin-notification-btn-inquiries" title="Notifications">
                                <i class="fas fa-bell"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                      id="admin-notification-count-inquiries" style="display: none;">0</span>
                            </button>
                        </div>
                    </div>
