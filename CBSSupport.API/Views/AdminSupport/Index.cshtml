@{
    Layout = null;
    var attachmentsEnabled = AttachmentCapability.CanCreateUploadIntents;
}
@inject CBSSupport.API.Attachments.AttachmentUiCapability AttachmentCapability
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Panel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-attachments-enabled="@attachmentsEnabled.ToString().ToLowerInvariant()">

    <div hidden aria-hidden="true">@Html.AntiForgeryToken()</div>
    <a class="skip-link" href="#admin-main-content">Skip to main content</a>

    <div class="admin-container">
        <aside class="admin-sidebar">
            <div class="sidebar-header">
                 CBS Support
            </div>
            <nav aria-label="Admin navigation">
                <ul class="sidebar-nav">
                    <li class="nav-item"><a class="nav-link active" href="#dashboard" data-page="dashboard" aria-current="page"><i class="bi bi-speedometer2" aria-hidden="true"></i> Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="#clients" data-page="clients"><i class="bi bi-buildings" aria-hidden="true"></i> Clients</a></li>
                    <li class="nav-item"><a class="nav-link" href="#ticket-management" data-page="ticket-management"><i class="bi bi-ticket-perforated" aria-hidden="true"></i> Ticket Management</a></li>
                    <li class="nav-item"><a class="nav-link" href="#inquiry-management" data-page="inquiry-management"><i class="bi bi-question-circle" aria-hidden="true"></i> Inquiry Management</a></li>
                    <li class="nav-item"><a class="nav-link" href="#chats" data-page="chats"><i class="bi bi-chat-square-text" aria-hidden="true"></i> Chats</a></li>
                </ul>
            </nav>

            <div class="sidebar-footer">
                <div>
                    <div class="user-info">
                        <i class="bi bi-person-circle" aria-hidden="true"></i>
                        <span id="admin-username-display">Loading...</span>
                    </div>
                    <span class="tenant-context admin-tenant-context" id="admin-tenant-context">Scope: All clients</span>
                </div>
                <form asp-controller="Login" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="logout-link border-0 bg-transparent p-0" title="Logout" aria-label="Logout">
                        <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                    </button>
                </form>
            </div>
        </aside>

        <main class="admin-content" id="admin-main-content" tabindex="-1">

            <!-- DASHBOARD PAGE -->
            <div id="dashboard-page" class="admin-page active">
                <div class="page-header">
                    <div>
                        <h1>Support overview</h1>
                        <p class="page-header-description">Monitor open work and move directly to items that need attention.</p>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex align-items-center">
                            <label for="client-switcher-dashboard" class="form-label me-2 mb-0">Client:</label>
                            <select id="client-switcher-dashboard" class="form-select client-switcher" style="width: 250px;">
                                <option value="">All Clients</option>
                            </select>
                        </div>

                        <div class="header-notification-container">
                            <button class="btn btn-outline-secondary header-notification-btn" id="admin-notification-btn" title="Notifications" aria-label="Notifications" aria-haspopup="true" aria-expanded="false">
                                <i class="bi bi-bell" aria-hidden="true"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                      id="admin-notification-count" style="display: none;">0</span>
                            </button>

                            <!-- MAIN NOTIFICATION DROPDOWN MENU -->
                            <div class="header-notification-dropdown-menu" id="admin-notification-menu">
                                <div class="notification-header">
                                    <h6>Notifications</h6>
                                    <button class="btn btn-sm btn-link" id="mark-all-read-btn">Mark all as read</button>
                                </div>
                                <div class="notification-list" id="admin-notification-list" aria-live="polite">
                                    <div class="notification-loading">
                                        <div class="spinner-border spinner-border-sm" aria-hidden="true"></div>
                                        <span>Loading notifications…</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="page-content admin-dashboard-content">
                    <section class="dashboard-command-bar" aria-label="Dashboard actions">
                        <div>
                            <h2 class="dashboard-command-title">Work overview</h2>
                            <p id="dashboard-scope-summary" class="dashboard-command-copy" aria-live="polite">Loading current support workload…</p>
                        </div>
                        <div class="dashboard-quick-actions">
                            <button type="button" class="btn btn-sm btn-primary clickable-card" data-action="view-all-tickets">
                                <i class="bi bi-ticket-perforated" aria-hidden="true"></i> Manage tickets
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary clickable-card" data-action="view-all-inquiries">
                                <i class="bi bi-question-circle" aria-hidden="true"></i> Manage inquiries
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary" data-page-target="chats">
                                <i class="bi bi-chat-square-text" aria-hidden="true"></i> Open chats
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="refresh-dashboard-btn">
                                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
                            </button>
                        </div>
                    </section>

                    <section class="dashboard-kpi-grid" aria-label="Support workload totals" aria-live="polite">
                        <button type="button" class="dashboard-kpi dashboard-kpi--danger clickable-card" data-action="view-unsolved-tickets">
                            <span class="dashboard-kpi-label">Open tickets</span>
                            <strong id="stat-open-tickets" class="dashboard-kpi-value">0</strong>
                            <span class="dashboard-kpi-meta"><span id="stat-total-tickets">0</span> tickets in scope</span>
                        </button>
                        <button type="button" class="dashboard-kpi dashboard-kpi--warning clickable-card" data-action="view-unsolved-inquiries">
                            <span class="dashboard-kpi-label">Pending inquiries</span>
                            <strong id="stat-unsolved-inquiries" class="dashboard-kpi-value">0</strong>
                            <span class="dashboard-kpi-meta"><span id="stat-total-inquiries">0</span> inquiries in scope</span>
                        </button>
                        <button type="button" class="dashboard-kpi dashboard-kpi--success clickable-card" data-action="view-solved-tickets">
                            <span class="dashboard-kpi-label">Resolved tickets</span>
                            <strong id="stat-resolved-tickets" class="dashboard-kpi-value">0</strong>
                            <span class="dashboard-kpi-meta" id="ticket-resolution-rate">0% resolved</span>
                        </button>
                        <button type="button" class="dashboard-kpi dashboard-kpi--neutral clickable-card" data-action="view-solved-inquiries">
                            <span class="dashboard-kpi-label">Completed inquiries</span>
                            <strong id="stat-solved-inquiries" class="dashboard-kpi-value">0</strong>
                            <span class="dashboard-kpi-meta" id="inquiry-completion-rate">0% completed</span>
                        </button>
                    </section>

                    <div class="dashboard-insight-grid">
                        <section class="dashboard-card dashboard-chart-card" aria-labelledby="workload-chart-title">
                            <div class="dashboard-card-heading">
                                <div>
                                    <h2 id="workload-chart-title" class="dashboard-section-title">Case status</h2>
                                    <p class="dashboard-section-copy">Open versus completed work in the loaded queue.</p>
                                </div>
                                <span class="dashboard-data-note">Latest 100 per case type</span>
                            </div>
                            <div id="dashboard-workload-chart" class="dashboard-chart" role="img" aria-label="Ticket and inquiry status comparison"></div>
                            <div id="dashboard-workload-summary" class="visually-hidden"></div>
                        </section>

                        <section class="dashboard-card dashboard-chart-card" aria-labelledby="priority-chart-title">
                            <div class="dashboard-card-heading">
                                <div>
                                    <h2 id="priority-chart-title" class="dashboard-section-title">Active ticket priority</h2>
                                    <p class="dashboard-section-copy">Where the open-ticket queue needs attention.</p>
                                </div>
                            </div>
                            <div id="ticket-priority-chart" class="dashboard-chart" role="img" aria-label="Open tickets by priority"></div>
                            <div id="ticket-priority-summary" class="dashboard-chart-legend" aria-live="polite"></div>
                        </section>
                    </div>

                    <div class="dashboard-worklist-grid">
                        <section class="dashboard-card dashboard-worklist" aria-labelledby="attention-tickets-title">
                            <div class="dashboard-card-heading dashboard-card-heading--danger">
                                <h2 id="attention-tickets-title" class="dashboard-section-title">Tickets needing attention</h2>
                                <span class="badge-status badge-status--danger" id="critical-tickets-badge">0 open</span>
                            </div>
                            <div id="unsolved-tickets-list" class="dashboard-item-list" aria-live="polite">
                                <div class="dashboard-loading"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Loading open tickets…</div>
                            </div>
                            <div class="dashboard-card-footer">
                                <a href="#" id="view-all-unsolved-tickets-link">View all open tickets <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                            </div>
                        </section>

                        <section class="dashboard-card dashboard-worklist" aria-labelledby="pending-inquiries-title">
                            <div class="dashboard-card-heading dashboard-card-heading--warning">
                                <h2 id="pending-inquiries-title" class="dashboard-section-title">Pending inquiries</h2>
                                <span class="badge-status badge-status--warning" id="pending-inquiries-badge">0 pending</span>
                            </div>
                            <div id="unsolved-inquiries-list" class="dashboard-item-list" aria-live="polite">
                                <div class="dashboard-loading"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Loading pending inquiries…</div>
                            </div>
                            <div class="dashboard-card-footer">
                                <a href="#" id="view-all-unsolved-inquiries-link">View all pending inquiries <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                            </div>
                        </section>
                    </div>

                    <section class="dashboard-card dashboard-recent" aria-labelledby="recent-activity-title">
                        <div class="dashboard-card-heading">
                            <div>
                                <h2 id="recent-activity-title" class="dashboard-section-title">Recent ticket activity</h2>
                                <p class="dashboard-section-copy">The latest ticket updates in the selected scope.</p>
                            </div>
                            <a href="#" id="view-all-tickets-link" class="btn btn-sm btn-outline-primary">View all tickets</a>
                        </div>
                        <div id="recent-tickets-list" class="dashboard-recent-list" aria-live="polite"></div>
                    </section>
                </div>
            </div>

            <div id="clients-page" class="admin-page">
                <div class="page-header">
                    <div>
                        <h1>Client directory</h1>
                        <p class="page-header-description">Choose a client context for support work. Account records are managed in the core banking directory.</p>
                    </div>
                    <div class="header-notification-container">
                        <button class="btn btn-outline-secondary header-notification-btn" id="admin-notification-btn-clients" title="Notifications" aria-label="Notifications" aria-haspopup="true" aria-expanded="false">
                            <i class="bi bi-bell" aria-hidden="true"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                  id="admin-notification-count-clients" style="display: none;">0</span>
                        </button>
                    </div>
                </div>
                <div class="page-content">
                    <section class="client-directory-card" aria-labelledby="client-directory-heading">
                        <div class="client-directory-toolbar">
                            <div>
                                <h2 id="client-directory-heading">Support clients</h2>
                                <p id="client-directory-summary" class="mb-0" aria-live="polite">Loading clients…</p>
                            </div>
                            <div class="client-directory-search">
                                <label for="client-directory-search" class="visually-hidden">Search clients</label>
                                <input type="search" id="client-directory-search" class="form-control" autocomplete="off" placeholder="Search clients" />
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table align-middle mb-0 client-directory-table" aria-describedby="client-directory-summary">
                                <thead>
                                    <tr>
                                        <th scope="col">Client</th>
                                        <th scope="col">Client ID</th>
                                        <th scope="col" class="text-end"><span class="visually-hidden">Actions</span></th>
                                    </tr>
                                </thead>
                                <tbody id="client-directory-body"></tbody>
                            </table>
                        </div>
                        <div id="client-directory-state" class="empty-state compact-empty-state mx-auto" role="status" aria-live="polite">
                            <div class="spinner-border spinner-border-sm" aria-hidden="true"></div>
                            <span>Loading client directory…</span>
                        </div>
                    </section>
                </div>
            </div>

            <div id="chats-page" class="admin-page">
                <div class="page-header admin-chat-page-header">
                    <div>
                        <h1>Conversations</h1>
                        <p class="page-header-description">Respond to client, ticket, inquiry, and internal conversations.</p>
                    </div>
                    <div class="d-flex align-items-center gap-3 admin-chat-page-actions">
                        <div class="d-flex align-items-center">
                            <label for="client-switcher-chats" class="form-label me-2 mb-0">Client:</label>
                            <select id="client-switcher-chats" class="form-select client-switcher" style="width: 250px;"></select>
                        </div>
                        <button type="button" class="btn btn-primary" id="new-private-chat-btn"
                                data-bs-toggle="modal" data-bs-target="#new-private-chat-modal">
                            <i class="bi bi-person-plus me-1" aria-hidden="true"></i>
                            New private chat
                        </button>

                        <div class="header-notification-container">
                        <button class="btn btn-outline-secondary header-notification-btn" id="admin-notification-btn-chats" title="Notifications" aria-label="Notifications" aria-haspopup="true" aria-expanded="false">
                            <i class="bi bi-bell" aria-hidden="true"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                      id="admin-notification-count-chats" style="display: none;">0</span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="chat-dashboard-container">
                    <div id="admin-conversation-list-panel" class="admin-chat-sidebar">
                        <div class="admin-chat-sidebar-header">
                            <div>
                                <h2><i class="bi bi-chat-square-text" aria-hidden="true"></i> Conversations</h2>
                                <p class="admin-chat-sidebar-caption">Search or filter the current workspace.</p>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span id="admin-chat-connection-status" class="admin-chat-status"
                                      role="status" aria-live="polite">Connecting…</span>
                                <button class="btn btn-sm btn-outline-primary" id="refresh-conversations-btn"
                                        title="Refresh conversations" aria-label="Refresh conversations">
                                    <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                        <div class="admin-chat-tools">
                            <label for="admin-conversation-search" class="visually-hidden">Search conversations</label>
                            <input type="search" id="admin-conversation-search"
                                   class="form-control form-control-sm" autocomplete="off"
                                   placeholder="Search conversations" />
                            <label for="admin-conversation-filter" class="visually-hidden">Conversation type</label>
                            <select id="admin-conversation-filter" class="form-select form-select-sm">
                                <option value="all">All chats</option>
                                <option value="group">Group</option>
                                <option value="private">Private</option>
                                <option value="other">Tickets and inquiries</option>
                            </select>
                        </div>

                        <div class="admin-chat-panel-body" id="admin-conversation-list-container">
                            <div class="admin-chat-section">
                                <div class="admin-chat-section-header">
                                    <i class="bi bi-people me-2" aria-hidden="true"></i>
                                    <span>Group chat</span>
                                </div>
                                <div class="admin-chat-section-content" id="group-chats">
                                    <div class="admin-chat-loading">
                                        <div class="spinner-border spinner-border-sm me-2"></div>
                                        Loading group chat…
                                    </div>
                                </div>
                            </div>

                            <div class="admin-chat-section">
                                <div class="admin-chat-section-header">
                                    <i class="bi bi-person me-2" aria-hidden="true"></i>
                                    <span>Private chats</span>
                                    <button type="button" class="admin-chat-section-toggle"
                                            data-target="private-chats" aria-controls="private-chats"
                                            aria-expanded="true" aria-label="Toggle private chats">
                                        <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                    </button>
                                </div>
                                <div class="admin-chat-section-content" id="private-chats">
                                    <div class="admin-chat-loading">
                                        <div class="spinner-border spinner-border-sm me-2"></div>
                                        Loading private chats…
                                    </div>
                                </div>
                            </div>

                            <div class="admin-chat-section">
                                <div class="admin-chat-section-header">
                                    <i class="bi bi-ticket-perforated me-2" aria-hidden="true"></i>
                                    <span>Support tickets</span>
                                    <button type="button" class="admin-chat-section-toggle"
                                            data-target="ticket-chats" aria-controls="ticket-chats"
                                            aria-expanded="true" aria-label="Toggle ticket chats">
                                        <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                    </button>
                                </div>
                                <div class="admin-chat-section-content" id="ticket-chats">
                                    <div class="admin-chat-loading">
                                        <div class="spinner-border spinner-border-sm me-2"></div>
                                        Loading support tickets…
                                    </div>
                                </div>
                            </div>

                            <div class="admin-chat-section">
                                <div class="admin-chat-section-header">
                                    <i class="bi bi-question-circle me-2" aria-hidden="true"></i>
                                    <span>Inquiries</span>
                                    <button type="button" class="admin-chat-section-toggle"
                                            data-target="inquiry-chats" aria-controls="inquiry-chats"
                                            aria-expanded="true" aria-label="Toggle inquiry chats">
                                        <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                    </button>
                                </div>
                                <div class="admin-chat-section-content" id="inquiry-chats">
                                    <div class="admin-chat-loading">
                                        <div class="spinner-border spinner-border-sm me-2"></div>
                                        Loading inquiries…
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="admin-chat-main">
                        <div id="chat-header" class="admin-chat-main-header">
                            <button type="button" class="btn btn-sm btn-outline-secondary admin-chat-back"
                                    id="admin-chat-back-btn" aria-label="Back to conversations">
                                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                            </button>
                            <div class="admin-chat-header-info">
                                <div class="admin-chat-title-row">
                                    <div class="admin-chat-title">Select a conversation</div>
                                    <span id="admin-chat-context-badge" class="admin-chat-context-badge">No conversation selected</span>
                                </div>
                                <div class="admin-chat-subtitle">Choose from the list to read and send messages.</div>
                            </div>
                            <div class="admin-chat-header-actions" aria-label="Conversation actions">
                                <button class="btn btn-outline-primary btn-sm" id="chat-transfer-btn"
                                        type="button" style="display: none;">
                                    <i class="bi bi-person-shield me-1" aria-hidden="true"></i>Transfer
                                </button>
                                <button class="btn btn-outline-danger btn-sm" id="chat-archive-btn"
                                        type="button" style="display: none;">
                                    <i class="bi bi-archive me-1" aria-hidden="true"></i>Archive
                                </button>
                            </div>
                        </div>

                        <div id="chat-panel-body" class="admin-chat-panel-body" role="log" aria-live="polite" aria-relevant="additions text">
                            <div class="admin-chat-placeholder">
                                <div class="admin-chat-placeholder-content">
                                    <i class="bi bi-chat-square-text admin-chat-placeholder-icon" aria-hidden="true"></i>
                                    <h3>Select a conversation</h3>
                                    <p class="text-muted">Choose a conversation from the list to review its history and reply.</p>
                                    <div class="admin-chat-quick-actions">
                                        <button class="btn btn-outline-primary btn-sm me-2" onclick="$('[data-page=ticket-management]').click()">
                                            <i class="bi bi-ticket-perforated me-1" aria-hidden="true"></i>View all tickets
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm" onclick="$('[data-page=inquiry-management]').click()">
                                            <i class="bi bi-question-circle me-1" aria-hidden="true"></i>View all inquiries
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="admin-chat-footer">
                            <div class="admin-typing-indicator" id="admin-typing-indicator" style="display: none;">
                                <span class="admin-typing-dots">
                                    <span></span>
                                    <span></span>
                                    <span></span>
                                </span>
                                <span class="admin-typing-text">Someone is typing…</span>
                            </div>
                            <div class="admin-chat-input-container">
                                <div class="admin-chat-input-actions">
                                    <input id="admin-attachment-file-input" type="file"
                                           class="visually-hidden" aria-label="Choose attachments" />
                                    <button class="btn btn-outline-secondary btn-sm"
                                            id="admin-attachment-button" type="button"
                                            title="Add attachments" aria-label="Add attachments"
                                            hidden disabled>
                                        <i class="bi bi-paperclip" aria-hidden="true"></i>
                                    </button>
                                </div>
                                <label for="message-input" class="visually-hidden">Message</label>
                                <textarea class="form-control" placeholder="Type a message…"
                                          id="message-input" rows="1" maxlength="4000"
                                          aria-describedby="admin-composer-hint" disabled></textarea>
                                <button class="btn btn-primary" type="button" id="send-button" aria-label="Send message" disabled>
                                    <i class="bi bi-send" aria-hidden="true"></i>
                                    <span class="d-none d-sm-inline ms-1">Send</span>
                                </button>
                            </div>
                            <div id="admin-attachment-upload-list"
                                 class="attachment-upload-list" aria-live="polite"></div>
                            <small id="admin-composer-hint" class="admin-composer-hint">Enter to send · Shift+Enter for a new line</small>
                            <div id="admin-chat-send-status" class="admin-chat-send-status"
                                 role="status" aria-live="polite"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="new-private-chat-modal" tabindex="-1"
                 aria-labelledby="new-private-chat-title" aria-hidden="true">
                <div class="modal-dialog">
                    <form class="modal-content" id="new-private-chat-form">
                        <div class="modal-header">
                            <h2 class="modal-title fs-5" id="new-private-chat-title">New private chat</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label for="new-private-client" class="form-label">Client account</label>
                                <select id="new-private-client" class="form-select" required>
                                    <option value="">Choose a client account</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="new-private-user" class="form-label">Client user</label>
                                <select id="new-private-user" class="form-select" required disabled>
                                    <option value="">Choose a client account first</option>
                                </select>
                            </div>
                            <div id="new-private-chat-status" class="small" role="status"
                                 aria-live="polite"></div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary"
                                    data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary" id="new-private-chat-submit" disabled>
                                Start chat
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="modal fade" id="transfer-private-chat-modal" tabindex="-1"
                 aria-labelledby="transfer-private-chat-title" aria-hidden="true">
                <div class="modal-dialog">
                    <form class="modal-content" id="transfer-private-chat-form">
                        <div class="modal-header">
                            <h2 class="modal-title fs-5" id="transfer-private-chat-title">Transfer private chat</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label for="transfer-admin-user-id" class="form-label">New administrator</label>
                                <select class="form-select" id="transfer-admin-user-id" required disabled>
                                    <option value="">Loading administrators…</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="transfer-reason" class="form-label">Reason <span class="text-muted">(optional)</span></label>
                                <textarea id="transfer-reason" class="form-control" rows="3"
                                          maxlength="500"></textarea>
                            </div>
                            <p class="small text-muted mb-0">
                                Confirming transfers this exact private conversation away from you immediately.
                            </p>
                            <div id="transfer-private-chat-status" class="small mt-2" role="status"
                                 aria-live="polite"></div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary"
                                    data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger" id="transfer-private-chat-submit">
                                Confirm transfer
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div id="ticket-management-page" class="admin-page">
                <div class="page-header">
                    <div>
                        <h1>Support tickets</h1>
                        <p class="page-header-description">Review status, priority, and recent client requests.</p>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex align-items-center">
                            <label for="client-switcher-tickets" class="form-label me-2 mb-0">Client:</label>
                            <select id="client-switcher-tickets" class="form-select client-switcher" style="width: 200px;">
                                <option value="">All Clients</option>
                            </select>
                        </div>
                        <div class="d-flex align-items-center">
                            <label for="status-filter-tickets" class="form-label me-2 mb-0">Status:</label>
                            <select id="status-filter-tickets" class="form-select" style="width: 150px;">
                                <option value="">All statuses</option>
                                <option value="Open">Open</option>
                                <option value="Resolved">Resolved</option>
                            </select>
                        </div>

                        <div class="header-notification-container">
                            <button class="btn btn-outline-secondary header-notification-btn" id="admin-notification-btn-tickets" title="Notifications" aria-label="Notifications" aria-haspopup="true" aria-expanded="false">
                                <i class="bi bi-bell" aria-hidden="true"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                      id="admin-notification-count-tickets" style="display: none;">0</span>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="page-content">
                    <div class="ticket-management-layout">
                        <section class="ticket-list-panel" aria-labelledby="ticket-list-heading">
                            <h2 id="ticket-list-heading" class="visually-hidden">Ticket list</h2>
                            <div class="panel-body">
                                <table id="ticketsTable" class="table table-hover ticket-table" style="width:100%" aria-label="Support tickets">
                                    <thead></thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </section>
                        <div class="ticket-detail-panel">
                            <div id="ticket-detail-content" style="display: none;">
                                <div class="ticket-detail-header">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <span id="detail-ticket-id">#TKT-12345</span>
                                            <h2 id="detail-ticket-subject">Training request</h2>
                                        </div>
                                        <button type="button" id="btn-close-ticket-detail" class="btn btn-icon btn-outline-secondary" title="Close ticket details" aria-label="Close ticket details">
                                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="ticket-properties">
                                    <div class="ticket-metadata-grid">
                                    <div class="ticket-metadata-field">
                                        <label for="detail-ticket-status">Status</label>
                                        <select id="detail-ticket-status" class="form-select">
                                            <option value="Open">Open</option>
                                            <option value="Resolved">Resolved</option>
                                        </select>
                                    </div>
                                    <div class="ticket-metadata-field">
                                        <span class="ticket-metadata-label">Priority</span>
                                        <div id="detail-ticket-priority" class="ticket-metadata-value"></div>
                                    </div>
                                    <div class="ticket-metadata-field">
                                        <span class="ticket-metadata-label">Requester</span>
                                        <span id="detail-ticket-created-by" class="ticket-metadata-value">Not available</span>
                                    </div>
                                    <div class="ticket-metadata-field">
                                        <span class="ticket-metadata-label">Client</span>
                                        <span id="detail-ticket-client" class="ticket-metadata-value">Not available</span>
                                    </div>
                                    <div class="ticket-metadata-field">
                                        <span class="ticket-metadata-label">Created</span>
                                        <span id="detail-ticket-date" class="ticket-metadata-value">Not available</span>
                                    </div>
                                    <div class="ticket-metadata-field">
                                        <span class="ticket-metadata-label">Resolved by</span>
                                        <span id="detail-ticket-resolved-by" class="ticket-metadata-value">Not resolved</span>
                                    </div>
                                    <div class="ticket-metadata-field">
                                        <span class="ticket-metadata-label">Resolved</span>
                                        <span id="detail-ticket-resolved-date" class="ticket-metadata-value">Not resolved</span>
                                    </div>
                                    </div>
                                    <section class="ticket-request" aria-labelledby="ticket-request-heading">
                                        <h3 id="ticket-request-heading">Client request</h3>
                                        <div class="thread-message thread-message--client">
                                            <div id="detail-ticket-description" class="thread-message__body">No description available.</div>
                                        </div>
                                    </section>
                                    <div class="ticket-actions">
                                        <button type="button" id="btn-start-ticket-chat" class="btn btn-primary">
                                            <i class="bi bi-chat-square-text" aria-hidden="true"></i> Open ticket conversation
                                        </button>
                                        <button type="button" id="btn-update-ticket" class="btn btn-secondary">
                                            <i class="bi bi-floppy" aria-hidden="true"></i> Save status
                                        </button>
                                    </div>
                                    <div class="inquiry-conversation-notice">
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-info-circle me-2" aria-hidden="true"></i>
                                            <span>Replies are sent through the ticket conversation, where the full message history is preserved.</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div id="ticket-detail-placeholder" class="d-flex align-items-center justify-content-center h-100">
                                <div class="empty-state compact-empty-state">
                                    <h2>Select a ticket</h2>
                                    <p>Choose a row to review its request, status, and conversation.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="inquiry-management-page" class="admin-page">
                <div class="page-header">
                    <div>
                        <h1>Inquiries</h1>
                        <p class="page-header-description">Review client questions and track their current outcome.</p>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex align-items-center">
                            <label for="client-switcher-inquiries" class="form-label me-2 mb-0">Client:</label>
                            <select id="client-switcher-inquiries" class="form-select client-switcher" style="width: 200px;">
                                <option value="">All Clients</option>
                            </select>
                        </div>
                        <div class="d-flex align-items-center">
                            <label for="status-filter-inquiries" class="form-label me-2 mb-0">Status:</label>
                            <select id="status-filter-inquiries" class="form-select" style="width: 150px;">
                                <option value="">All statuses</option>
                                <option value="Pending">Pending</option>
                                <option value="Completed">Completed</option>
                            </select>
                        </div>
                        <div class="header-notification-container">
                            <button class="btn btn-outline-secondary header-notification-btn" id="admin-notification-btn-inquiries" title="Notifications" aria-label="Notifications" aria-haspopup="true" aria-expanded="false">
                                <i class="bi bi-bell" aria-hidden="true"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                      id="admin-notification-count-inquiries" style="display: none;">0</span>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="page-content">
                    <div class="inquiry-management-layout">
                        <section class="inquiry-list-panel" aria-labelledby="inquiry-list-heading">
                            <h2 id="inquiry-list-heading" class="visually-hidden">Inquiry list</h2>
                            <div class="panel-body">
                                <table id="inquiriesDataTable" class="table table-hover inquiry-table" style="width:100%" aria-label="Client inquiries">
                                    <thead></thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </section>
                        <div class="inquiry-detail-panel">
                            <div id="inquiry-detail-content" style="display: none;">
                                <div class="inquiry-detail-header">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <span id="detail-inquiry-id">#INQ-68915</span>
                                            <div id="detail-inquiry-topic-container">
                                                <h2 id="detail-inquiry-topic">Account inquiry</h2>
                                            </div>
                                        </div>
                                        <button type="button" id="btn-close-inquiry-detail" class="btn btn-icon btn-outline-secondary" title="Close inquiry details" aria-label="Close inquiry details">
                                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="inquiry-properties">
                                    <div class="inquiry-metadata-grid">
                                    <div class="inquiry-metadata-field">
                                        <label for="detail-inquiry-outcome">Outcome</label>
                                        <select id="detail-inquiry-outcome" class="form-select">
                                            <option value="Pending">Pending</option>
                                            <option value="Completed">Completed</option>
                                        </select>
                                    </div>
                                    <div class="inquiry-metadata-field">
                                        <span class="inquiry-metadata-label">Submitted by</span>
                                        <span id="detail-inquiry-inquired-by" class="inquiry-metadata-value">Not available</span>
                                    </div>
                                    <div class="inquiry-metadata-field">
                                        <span class="inquiry-metadata-label">Client</span>
                                        <span id="detail-inquiry-client" class="inquiry-metadata-value">Not available</span>
                                    </div>
                                    <div class="inquiry-metadata-field">
                                        <span class="inquiry-metadata-label">Submitted</span>
                                        <span id="detail-inquiry-date" class="inquiry-metadata-value">Not available</span>
                                    </div>
                                    </div>
                                    <section class="inquiry-request" aria-labelledby="inquiry-request-heading">
                                        <h3 id="inquiry-request-heading">Client inquiry</h3>
                                        <div class="thread-message thread-message--client">
                                            <div id="detail-inquiry-description" class="thread-message__body">No description provided.</div>
                                        </div>
                                    </section>
                                    <div class="inquiry-actions">
                                        <button type="button" id="btn-start-inquiry-chat" class="btn btn-primary">
                                            <i class="bi bi-chat-square-text" aria-hidden="true"></i> Open inquiry conversation
                                        </button>
                                        <button type="button" id="btn-update-inquiry" class="btn btn-secondary">
                                            <i class="bi bi-floppy" aria-hidden="true"></i> Save outcome
                                        </button>
                                    </div>
                                </div>
                                <div class="inquiry-conversation-notice">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-info-circle me-2" aria-hidden="true"></i>
                                        <span>Responses are sent through the inquiry conversation, where the full message history is preserved.</span>
                                    </div>
                                </div>
                            </div>
                            <div id="inquiry-detail-placeholder" class="d-flex align-items-center justify-content-center h-100">
                                <div class="empty-state compact-empty-state">
                                    <h2>Select an inquiry</h2>
                                    <p>Choose a row to review its question, outcome, and conversation.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="floating-chat-container"></div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/messaging/store.js" asp-append-version="true"></script>
    <script src="~/js/messaging/api.js" asp-append-version="true"></script>
    <script src="~/js/messaging/transport.js" asp-append-version="true"></script>
    <script src="~/js/messaging/client.js" asp-append-version="true"></script>
    <script src="~/js/messaging/attachments.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/d3@7.9.0/dist/d3.min.js"
            integrity="sha384-CjloA8y00+1SDAUkjs099PVfnY2KmDC2BZnws9kh8D/lX1s46w6EPhpXdqMfjK6i"
            crossorigin="anonymous"></script>
    <script src="~/js/security/antiforgery.js" asp-append-version="true"></script>
    <script src="~/js/admin/admin-utils.js" asp-append-version="true"></script>
    <script src="~/js/admin/admin-notification.js" asp-append-version="true"></script>
    <script src="~/js/admin/admin-dashboard.js" asp-append-version="true"></script>
    <script src="~/js/admin/admin-navigation.js" asp-append-version="true"></script>
    <script src="~/js/admin/admin-chat.js" asp-append-version="true"></script>
    <script src="~/js/admin/admin-tickets.js" asp-append-version="true"></script>
    <script src="~/js/admin/admin-inquiries.js" asp-append-version="true"></script>
    <script src="~/js/admin/admin-signalR.js" asp-append-version="true"></script>

    <script src="~/js/admin/admin-core.js" asp-append-version="true"></script>


</body>
</html>
