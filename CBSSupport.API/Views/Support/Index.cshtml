@{
    Layout = null;
    var attachmentsEnabled = AttachmentCapability.CanCreateUploadIntents;
}
@inject CBSSupport.API.Attachments.AttachmentUiCapability AttachmentCapability
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Client Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="client-portal" data-attachments-enabled="@attachmentsEnabled.ToString().ToLowerInvariant()">

    <div hidden aria-hidden="true">@Html.AntiForgeryToken()</div>
    <a class="skip-link" href="#client-main-content">Skip to main content</a>

    <header class="app-header">
        <div class="header-left">
            <img src="~/images/infobrain-logo.jpg" alt="InfoBrain Technologies" class="header-logo" />
            <div class="header-brand-text">CBS Support</div>
            <span class="tenant-context">Client account · @ViewBag.ClientId</span>
        </div>
        <div class="header-right">
            <div class="user-info" aria-label="Current session">
                <span class="user-greeting">Hello, @ViewBag.UserFullName</span>
                <time datetime="@DateTime.Now.ToString("yyyy-MM-dd")">@DateTime.Now.ToString("ddd, MMM d")</time>
            </div>
            <div class="header-actions">
                <button class="btn btn-icon" id="fullscreen-btn" title="Toggle Fullscreen" aria-label="Toggle fullscreen"><i class="fas fa-expand" aria-hidden="true"></i></button>

                <div class="client-notification-container">
                    <button class="btn btn-icon client-notification-btn" id="client-notification-btn" title="Notifications" aria-label="Notifications" aria-controls="client-notification-menu" aria-expanded="false">
                        <i class="fas fa-bell" aria-hidden="true"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                              id="client-notification-count" style="display: none;">0</span>
                    </button>

                    <div class="client-notification-dropdown-menu" id="client-notification-menu" role="region" aria-label="Notifications">
                        <div class="notification-header">
                            <h6>Notifications</h6>
                            <button class="btn btn-sm btn-link" id="client-mark-all-read-btn">Mark all as read</button>
                        </div>
                        <div class="notification-list" id="client-notification-list" aria-live="polite">
                            <div class="notification-loading">
                                <div class="spinner-border spinner-border-sm" aria-hidden="true"></div>
                                <span>Loading notifications…</span>
                            </div>
                        </div>
                    </div>
                </div>
                <button class="btn btn-icon" data-bs-toggle="modal" data-bs-target="#userModal" title="Account" aria-label="Open account details">
                    <i class="fas fa-user" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </header>

    <main class="dashboard-container" id="client-main-content" tabindex="-1" aria-label="Client support workspace">
        <div id="conversation-list-panel" class="dashboard-panel client-conversation-panel">
            <div class="panel-header client-conversation-heading">
                <div>
                    <h1 class="client-conversation-title">Messages</h1>
                    <span id="connection-status"
                          class="client-connection-status"
                          role="status"
                          aria-live="polite">Connecting…</span>
                </div>
                <button class="btn btn-sm btn-primary"
                        id="new-private-chat-btn"
                        type="button"
                        data-bs-toggle="modal"
                        data-bs-target="#newPrivateChatModal">
                    <i class="fas fa-pen-to-square" aria-hidden="true"></i>
                    <span>New private chat</span>
                </button>
            </div>
            <div class="client-conversation-tools">
                <label for="conversation-search" class="visually-hidden">Search conversations</label>
                <input type="search" id="conversation-search" class="form-control form-control-sm"
                       autocomplete="off" placeholder="Search conversations" />
                <label for="conversation-kind-filter" class="visually-hidden">Conversation type</label>
                <select id="conversation-kind-filter" class="form-select form-select-sm">
                    <option value="all">All chats</option>
                    <option value="group">Group</option>
                    <option value="private">Private</option>
                    <option value="ticket">Tickets</option>
                    <option value="inquiry">Inquiries</option>
                </select>
            </div>
            <div class="panel-body" id="conversation-list-container"
                 aria-live="polite"
                 aria-busy="true">
                <div class="client-chat-state" id="conversation-list-state">
                    <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                    <span>Loading conversations…</span>
                </div>
                <div class="list-group list-group-flush conversation-list"
                     id="client-conversation-list"
                     aria-label="Your conversations"></div>
            </div>
        </div>

        <div id="chat-panel" class="dashboard-panel client-chat-detail">
            <div class="panel-header" id="chat-header">
                <button type="button" id="mobile-conversation-back"
                        class="btn btn-sm btn-outline-secondary client-chat-back"
                        aria-label="Back to conversations">
                    <i class="fas fa-arrow-left" aria-hidden="true"></i>
                </button>
                <div>
                    <div class="fw-bold" id="chat-heading">Select a conversation</div>
                    <small class="text-muted" id="chat-subheading">Choose a chat to read messages.</small>
                </div>
            </div>
            <div id="chat-panel-body" class="panel-body" aria-live="polite">
                <div class="client-chat-state client-chat-empty">
                    <i class="fas fa-comments" aria-hidden="true"></i>
                    <span>Select a conversation to start messaging.</span>
                </div>
            </div>
            <div class="chat-footer" id="chat-footer">
                <div id="typing-indicator" class="typing-indicator"></div>
                <div id="send-state" class="client-send-state" role="status" aria-live="polite"></div>
                <div id="attachment-upload-list" class="attachment-upload-list" aria-live="polite"></div>
                <div class="chat-input-container">
                    <input id="attachment-file-input" type="file" class="visually-hidden"
                           aria-label="Choose attachments" />
                    <button class="btn btn-outline-secondary" type="button"
                            id="attachment-button" aria-label="Add attachments"
                            hidden disabled>
                        <i class="fas fa-paperclip" aria-hidden="true"></i>
                    </button>
                    <label for="message-input" class="visually-hidden">Message</label>
                    <textarea class="form-control"
                              placeholder="Type a message…"
                              id="message-input"
                              rows="1"
                              maxlength="4000"
                              disabled></textarea>
                    <button class="btn btn-primary" type="button" id="send-button"
                            aria-label="Send message" disabled>
                        <i class="fas fa-paper-plane" aria-hidden="true"></i>
                    </button>
                </div>
                <small class="client-composer-hint">Enter to send · Shift+Enter for a new line</small>
            </div>
        </div>

        <div id="history-column">
            <div class="history-panel">
                <div class="panel-header d-flex justify-content-between align-items-center"><h2 class="panel-title">My support tickets</h2><button id="newSupportTicketBtn" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#newSupportTicketModal">New support ticket</button></div>
                <div class="history-table-container panel-body">
                    <table id="supportTicketsDataTable" class="table table-hover table-sm small" style="width:100%">
                        <thead>

                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="history-panel">
                <div class="panel-header d-flex justify-content-between align-items-center">
                    <h2 class="panel-title">My inquiries</h2>
                    <button id="newInquiryBtn" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#newInquiryModal">New inquiry</button>
                </div>
                <div class="history-table-container panel-body">
                    <table id="inquiriesDataTable" class="table table-hover table-sm small" style="width:100%">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Topic</th>
                                <th>Inquired By</th>
                                <th>Date</th>
                                <th>Outcome</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <div class="modal fade" id="newPrivateChatModal" tabindex="-1"
         aria-labelledby="newPrivateChatModalLabel" aria-describedby="newPrivateChatModalDescription" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="newPrivateChatModalLabel">New private chat</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted" id="newPrivateChatModalDescription">Choose an available support administrator.</p>
                    <label for="available-admins-search" class="form-label">Search administrators</label>
                    <input type="search" id="available-admins-search" class="form-control mb-3"
                           autocomplete="off" placeholder="Search by name" />
                    <div id="available-admins-state" class="client-chat-state" role="status" aria-live="polite"></div>
                    <div id="available-admins-list"
                         class="list-group client-admin-picker"
                         role="list"
                         aria-label="Available administrators"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="newSupportTicketModal" tabindex="-1" aria-labelledby="newSupportTicketModalLabel" aria-describedby="newSupportTicketModalDescription" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content support-dialog">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="newSupportTicketModalLabel">New support ticket</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="support-dialog-description" id="newSupportTicketModalDescription">Describe the issue, its urgency, and when you need a response.</p>
                    <form id="supportTicketForm" novalidate>
                        <fieldset class="support-form-section">
                            <legend>Request details</legend>
                            <div class="mb-3">
                                <label for="fullName" class="form-label">Full Name *</label>
                                <input type="text" class="form-control" id="fullName" autocomplete="name" placeholder="Enter your full name" required>
                            </div>
                            <div class="row g-3 mb-3">
                                <div class="col-md-7">
                                    <label for="ticketSubject" class="form-label">Subject *</label>
                                    <select id="ticketSubject" class="form-select" required>
                                        <option value="" disabled selected>Select a subject…</option>
                                        <option value="ticket/training">Training</option>
                                        <option value="ticket/migration">Migration</option>
                                        <option value="ticket/setup">Setup</option>
                                        <option value="ticket/correction">Correction</option>
                                        <option value="ticket/bug-fix">Bug fix</option>
                                        <option value="ticket/new-feature">New feature request</option>
                                        <option value="ticket/feature-enhancement">Feature enhancement</option>
                                        <option value="ticket/backend-workaround">Backend workaround</option>
                                    </select>
                                </div>
                                <div class="col-md-5">
                                    <label for="ticketPriority" class="form-label">Priority *</label>
                                    <select id="ticketPriority" class="form-select" required>
                                        <option value="Low" selected>Low</option>
                                        <option value="Normal">Medium</option>
                                        <option value="Urgent">High</option>
                                    </select>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label for="ticketExpiryDate" class="form-label">Expected Resolution Time *</label>
                                <input type="datetime-local" class="form-control" id="ticketExpiryDate" required />
                            </div>
                            <div class="mb-3">
                                <label for="ticketDescription" class="form-label">Description *</label>
                                <textarea class="form-control" id="ticketDescription" rows="5" placeholder="Describe what happened, what you expected, and any impact." required></textarea>
                            </div>
                            <div>
                                <label for="ticketRemarks" class="form-label">Remarks <span class="form-label-optional">Optional</span></label>
                                <textarea class="form-control" id="ticketRemarks" rows="3" placeholder="Add context that may help the support team."></textarea>
                            </div>
                        </fieldset>
                        <p class="form-required-note">* Required fields</p>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" form="supportTicketForm" class="btn btn-primary">Submit Request</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="viewInquiryDetailsModal" tabindex="-1" aria-labelledby="viewInquiryDetailsModalLabel" aria-describedby="inquiry-details-view" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content support-dialog">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="viewInquiryDetailsModalLabel">Inquiry details</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="inquiry-details-view" class="support-record">
                        <dl class="support-record-grid">
                            <div><dt>Inquiry ID</dt><dd id="inquiry-details-id">#INQ-…</dd></div>
                            <div><dt>Submitted</dt><dd id="inquiry-details-date">Not available</dd></div>
                            <div><dt>Outcome</dt><dd id="inquiry-details-outcome">Not available</dd></div>
                            <div><dt>Submitted by</dt><dd id="inquiry-details-inquiredBy">Not available</dd></div>
                        </dl>
                        <section class="support-record-section" aria-labelledby="inquiry-topic-label">
                            <h3 id="inquiry-topic-label">Topic</h3>
                            <p id="inquiry-details-topic">Not available</p>
                        </section>
                        <section class="support-record-section" aria-labelledby="inquiry-description-label">
                            <h3 id="inquiry-description-label">Inquiry</h3>
                            <p id="inquiry-details-description" class="support-record-message">No description provided.</p>
                        </section>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="newInquiryModal" tabindex="-1" aria-labelledby="newInquiryModalLabel" aria-describedby="newInquiryModalDescription" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content support-dialog">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="newInquiryModalLabel">New inquiry</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="support-dialog-description" id="newInquiryModalDescription">Ask the support team about accounts, sales, or management.</p>
                    <form id="inquiryForm">
                        <div class="support-form-context" aria-label="Inquiry recipient">
                            <span>Send to</span>
                            <strong>CBS Support team</strong>
                        </div>
                        <fieldset class="support-form-section">
                            <legend>Inquiry details</legend>
                            <div class="mb-3">
                            <label for="inquirySubject" class="form-label">Subject *</label>
                            <select class="form-select" id="inquirySubject" required>
                                <option value="" disabled selected>Select an inquiry type…</option>
                                <option value="Account Inquiry">Account inquiry</option>
                                <option value="Sales and Management">Sales and management</option>
                            </select>
                        </div>
                            <div>
                                <label for="inquiryMessage" class="form-label">Inquiry Details *</label>
                                <textarea class="form-control" id="inquiryMessage" rows="8" placeholder="Describe your question and include any relevant context." required></textarea>
                            </div>
                        </fieldset>
                        <p class="form-required-note">* Required fields</p>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" form="inquiryForm" class="btn btn-primary">Send Inquiry</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="userModal" tabindex="-1" aria-labelledby="userModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="userModalLabel">Your account</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="account-summary">
                        <div class="account-avatar" aria-hidden="true"><i class="fas fa-user"></i></div>
                        <div>
                            <div class="account-name">@ViewBag.UserFullName</div>
                            <div class="account-role">Client user</div>
                        </div>
                    </div>
                    <dl class="account-metadata">
                        <div>
                            <dt>Client account</dt>
                            <dd>@ViewBag.ClientId</dd>
                        </div>
                        <div>
                            <dt>Workspace</dt>
                            <dd>CBS Support</dd>
                        </div>
                    </dl>
                    <div class="d-grid">
                        <form asp-controller="Login" asp-action="Logout" method="post" class="d-grid">
                            <button type="submit" class="btn btn-outline-danger">
                                <i class="fas fa-sign-out-alt me-2" aria-hidden="true"></i>Log out
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="viewTicketDetailsModal" tabindex="-1" aria-labelledby="viewTicketDetailsModalLabel" aria-describedby="ticket-details-view" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content support-dialog">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="viewTicketDetailsModalLabel">Ticket details</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="ticket-details-view" class="support-record">
                        <dl class="support-record-grid">
                            <div><dt>Ticket ID</dt><dd id="details-id">#…</dd></div>
                            <div><dt>Submitted</dt><dd id="details-date">Not available</dd></div>
                            <div><dt>Expected resolution</dt><dd id="details-expiryDate">Not available</dd></div>
                            <div><dt>Status</dt><dd id="details-status">Not available</dd></div>
                            <div><dt>Priority</dt><dd id="details-priority">Not available</dd></div>
                            <div><dt>Created by</dt><dd id="details-createdBy">Not available</dd></div>
                            <div><dt>Resolved by</dt><dd id="details-resolvedBy">Not available</dd></div>
                        </dl>
                        <section class="support-record-section" aria-labelledby="ticket-subject-label">
                            <h3 id="ticket-subject-label">Subject</h3>
                            <p id="details-subject">Not available</p>
                        </section>
                        <section class="support-record-section" aria-labelledby="ticket-description-label">
                            <h3 id="ticket-description-label">Request</h3>
                            <p id="details-description" class="support-record-message">No description provided.</p>
                        </section>
                        <section class="support-record-section" aria-labelledby="ticket-remarks-label">
                            <h3 id="ticket-remarks-label">Your remarks</h3>
                            <p id="details-remarks" class="support-record-message">No remarks provided.</p>
                        </section>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script id="client-bootstrap-data" type="application/json">
        @Html.Raw(Json.Serialize(new
        {
            currentUserId = ViewBag.UserId,
            currentUserName = ViewBag.UserFullName
        }))
    </script>
    <script src="https://code.jquery.com/jquery-3.7.0.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/messaging/store.js" asp-append-version="true"></script>
    <script src="~/js/messaging/api.js" asp-append-version="true"></script>
    <script src="~/js/messaging/transport.js" asp-append-version="true"></script>
    <script src="~/js/messaging/client.js" asp-append-version="true"></script>
    <script src="~/js/messaging/attachments.js" asp-append-version="true"></script>
    <script src="~/js/security/antiforgery.js" asp-append-version="true"></script>
    <script src="~/js/chat.js" asp-append-version="true"></script>
</body>
</html>
