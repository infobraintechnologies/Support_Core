@model CBSSupport.Shared.Models.LoginViewModel
@using Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In - CBS Support</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="login-container">
        <div class="login-branding">
            <img src="~/images/infobrain-logo.png" alt="Info Brain Technologies" class="branding-logo">
            <p class="branding-eyebrow">Info Brain Technologies</p>
            <h1 class="branding-title">CBS Support</h1>
            <p class="branding-subtitle">A clear, secure workspace for client support.</p>
        </div>
        <div class="login-form-panel">
            <div class="login-heading">
                <h2>Sign in</h2>
                <p id="roleHelp">Choose your account type, then enter your credentials.</p>
            </div>

            <form id="mainLoginForm" asp-controller="Login" asp-action="Index" method="post" asp-antiforgery="true">

                <fieldset class="role-selector" id="roleSelectorContainer" aria-describedby="roleHelp">
                    <legend class="visually-hidden">Sign in as</legend>
                    <div class="role-selector-slider"></div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="roleType" id="adminRole" value="admin" checked>
                        <label class="form-check-label" for="adminRole">Admin</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="roleType" id="clientRole" value="client">
                        <label class="form-check-label" for="clientRole">Client</label>
                    </div>
                </fieldset>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <!-- ADMIN FORM (Initially visible) -->
                <div id="adminForm" role="group" aria-labelledby="adminFormHeading">
                    <h3 id="adminFormHeading" class="visually-hidden">Administrator sign in</h3>
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label"></label>
                        <input asp-for="Username" class="form-control" autocomplete="username" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" type="password" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                </div>

                <!-- CLIENT FORM (Initially hidden) -->
                <div id="clientForm" role="group" aria-labelledby="clientFormHeading" hidden>
                    <h3 id="clientFormHeading" class="visually-hidden">Client sign in</h3>
                    <div class="mb-3">
                        <label asp-for="ClientLogin.ClientCode" class="form-label"></label>
                        <input asp-for="ClientLogin.ClientCode" class="form-control" type="number" inputmode="numeric" autocomplete="organization" />
                        <span asp-validation-for="ClientLogin.ClientCode" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ClientLogin.Username" class="form-label"></label>
                        <input asp-for="ClientLogin.Username" class="form-control" autocomplete="username" />
                        <span asp-validation-for="ClientLogin.Username" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ClientLogin.Password" class="form-label"></label>
                        <input asp-for="ClientLogin.Password" class="form-control" type="password" autocomplete="current-password" />
                        <span asp-validation-for="ClientLogin.Password" class="text-danger"></span>
                    </div>
                </div>

                <!-- Common Fields -->
                <div class="login-options mb-4">
                    <div class="form-check">
                        <input type="checkbox" asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>
                    <span id="passwordRecoveryHelp" class="password-recovery-help" role="note">
                        Password recovery is not available online. Contact your CBS Support administrator for help with your credentials.
                    </span>
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-login">Sign in</button>
                </div>
            </form>
            <p class="login-footer">© @DateTime.Now.Year Info Brain Technologies Pvt. Ltd.</p>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/login.js" asp-append-version="true"></script>
</body>
</html>
